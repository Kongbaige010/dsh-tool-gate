{
  "name": "@kongbaige010/dsh-tool-gate",
  "version": "0.3.0",
  "private": false,
  "description": "Tool gating for DeepSeekRuntime: managed MCP services and low-frequency tool groups stay out of the prompt until opened, plus a read-only badge in the assistant action row and a fixed entry point for the current instance.",
  "type": "module",
  "author": "dsh-tool-gate contributors",
  "license": "MIT",
  "homepage": "https://github.com/Kongbaige010/dsh-tool-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kongbaige010/dsh-tool-gate.git"
  },
  "bugs": {
    "url": "https://github.com/Kongbaige010/dsh-tool-gate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "index.js",
    "gate",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "tool-gate",
    "tokens"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
